PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pokerapp
# Cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esto-por-un-secreto-largo
# URL pública (para los enlaces de invitación / QR)
PUBLIC_URL=http://localhost:5173
NODE_ENV=development
# Escaneo de cartas con foto (Claude, visión). Opcional: sin clave el botón de escanear no aparece.
# Consigue la clave en https://platform.claude.com
ANTHROPIC_API_KEY=
